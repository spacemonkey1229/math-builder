{
  "_schema": {
    "source": "User-supplied Tree of Thought curriculum map, 2026-07-31",
    "note": "Phases 1-2 are the case-study target band. Phase 3 is the stretch/extension band. Phase 4 is interdisciplinary framing, not a course.",
    "fields": "id, phase, branch, objective, description, core_topics[], critical_dependency, prereqs[], band, acton_domains[] (which of the 8 legacy standards sheets feed this branch)",
    "intersections_note": "intersections[] is DERIVED from readmodel/domains.json by app/build_domains.py — do not hand-edit. The original three hand-written intersections are preserved verbatim in legacy_intersections[]. Full domain records (signature skills, data sources, careers, authoring priority) live in domains.json; the join key is ref / domains.json#<id>."
  },
  "phases": [
    {
      "phase": 1,
      "name": "The Trunk — Middle School Foundations",
      "icon": "trunk",
      "objective": "Shift from concrete arithmetic to symbolic abstraction and logical reasoning."
    },
    {
      "phase": 2,
      "name": "The Main Branches — Core High School Mathematics",
      "icon": "branch",
      "objective": "Formalize analytical modeling, spatial reasoning, and continuous functions."
    },
    {
      "phase": 3,
      "name": "The Upper Canopy — Advanced & Applied Mathematics",
      "icon": "canopy",
      "objective": "Transition into infinite processes, multi-dimensional structures, and data systems."
    },
    {
      "phase": 4,
      "name": "Root Connections — Interdisciplinary Intersections",
      "icon": "roots",
      "objective": "Bind mathematical branches to the domains that consume them."
    }
  ],
  "branches": [
    {
      "id": "pre-algebra",
      "phase": 1,
      "branch": "Pre-Algebra",
      "band": "MS",
      "description": "Establishes the rules of variables, fractions, and numeric operations. Bridges computation and mathematical abstraction.",
      "core_topics": [
        "Integers",
        "Fractions",
        "Decimals",
        "Ratios",
        "Proportions",
        "Percentages",
        "Basic linear equations",
        "Order of operations"
      ],
      "critical_dependency": "Must achieve absolute fluency in operations before starting formal Algebra.",
      "prereqs": [],
      "acton_domains": [
        "Number Sense",
        "Basic Operations",
        "Fractions",
        "Advanced Numbers",
        "Measurement"
      ]
    },
    {
      "id": "number-theory",
      "phase": 1,
      "branch": "Number Theory Essentials",
      "band": "MS",
      "description": "Explores the deep, fundamental structural properties of integers.",
      "core_topics": [
        "Primes",
        "Prime factorization",
        "Greatest common divisor (GCD)",
        "Least common multiple (LCM)",
        "Divisibility rules",
        "Modular arithmetic basics"
      ],
      "critical_dependency": "Builds structural thinking necessary for advanced algebra and cryptography.",
      "prereqs": [
        "pre-algebra"
      ],
      "acton_domains": [
        "Basic Operations",
        "Advanced Operations"
      ]
    },
    {
      "id": "algebra-1",
      "phase": 2,
      "branch": "Algebra 1",
      "band": "HS",
      "description": "Introduces the language of functions, equations, and coordinate graphing.",
      "core_topics": [
        "Linear equations and inequalities",
        "Systems of linear equations",
        "Exponents",
        "Polynomials",
        "Factoring",
        "Quadratic equations"
      ],
      "critical_dependency": "Formulates the core symbolic manipulation habits required for every subsequent math course.",
      "prereqs": [
        "pre-algebra"
      ],
      "acton_domains": [
        "Advanced Operations",
        "Statistics And Probability"
      ]
    },
    {
      "id": "geometry",
      "phase": 2,
      "branch": "Geometry",
      "band": "HS",
      "description": "Integrates spatial visual logic with deductive, axiomatic formal proofs.",
      "core_topics": [
        "Euclidean axioms",
        "Parallel lines",
        "Triangle congruence",
        "Similarity",
        "Coordinate geometry",
        "Area and volume",
        "Circles",
        "Introductory right-triangle trigonometry"
      ],
      "critical_dependency": "Develops rigorous logical argument construction and spatial proof mechanics.",
      "prereqs": [
        "pre-algebra",
        "algebra-1"
      ],
      "acton_domains": [
        "Geometry",
        "Measurement"
      ]
    },
    {
      "id": "algebra-2",
      "phase": 2,
      "branch": "Algebra 2",
      "band": "HS",
      "description": "Expands function analysis to complex, non-linear mathematical domains.",
      "core_topics": [
        "Complex numbers",
        "Systems of non-linear equations",
        "Rational functions",
        "Radical functions",
        "Exponential functions",
        "Logarithmic functions",
        "Sequences",
        "Series"
      ],
      "critical_dependency": "Mastery of logarithms and complex variables is mandatory before Pre-Calculus.",
      "prereqs": [
        "algebra-1"
      ],
      "acton_domains": [
        "Advanced Operations"
      ]
    },
    {
      "id": "precalc",
      "phase": 2,
      "branch": "Pre-Calculus & Trigonometry",
      "band": "HS",
      "description": "The formal study of continuous relationships, wrapping functions, and vectors to prepare for calculus.",
      "core_topics": [
        "Unit circle trigonometry",
        "Trigonometric identities",
        "Polar coordinates",
        "Vectors",
        "Parametric equations",
        "Matrices",
        "Rigorous introduction to limits"
      ],
      "critical_dependency": "Fluency with trigonometric transformations prevents structural failure in Calculus.",
      "prereqs": [
        "algebra-2",
        "geometry"
      ],
      "acton_domains": [
        "Pre-Calculus"
      ]
    },
    {
      "id": "calculus",
      "phase": 3,
      "branch": "Calculus (Single Variable)",
      "band": "Advanced",
      "description": "The study of continuous change through the twin lenses of local rates of change and accumulation.",
      "core_topics": [
        "Limits",
        "Continuity",
        "Derivatives",
        "Chain rule",
        "Optimization",
        "Integrals",
        "Fundamental Theorem of Calculus",
        "Area between curves",
        "Volumes of revolution",
        "Taylor and Maclaurin series"
      ],
      "critical_dependency": "Demands absolute mastery of algebraic manipulation and functional behavior.",
      "prereqs": [
        "precalc"
      ],
      "acton_domains": [
        "Calculus"
      ]
    },
    {
      "id": "prob-stats",
      "phase": 3,
      "branch": "Probability & Statistics",
      "band": "Advanced",
      "description": "Quantifies real-world uncertainty, structural variance, and inductive data interpretation.",
      "core_topics": [
        "Combinatorics",
        "Probability distributions (normal, binomial)",
        "Expected value",
        "Descriptive statistics",
        "Central limit theorem",
        "Confidence intervals",
        "Hypothesis testing"
      ],
      "critical_dependency": "Foundational for data science, financial modeling, and scientific research.",
      "prereqs": [
        "algebra-2"
      ],
      "acton_domains": [
        "Statistics And Probability"
      ]
    },
    {
      "id": "linear-algebra",
      "phase": 3,
      "branch": "Linear Algebra",
      "band": "Advanced",
      "description": "The study of geometric transformations across multi-dimensional vector spaces.",
      "core_topics": [
        "Vectors",
        "Vector spaces",
        "Matrices",
        "Systems of linear equations",
        "Determinants",
        "Eigenvalues and eigenvectors",
        "Linear transformations",
        "Orthogonality"
      ],
      "critical_dependency": "Structural bedrock for computer graphics, quantum mechanics, and machine learning architectures.",
      "prereqs": [
        "precalc"
      ],
      "acton_domains": [
        "Geometry"
      ]
    },
    {
      "id": "discrete",
      "phase": 3,
      "branch": "Discrete Mathematics",
      "band": "Advanced",
      "description": "Examines distinct, countable mathematical structures rather than smooth, continuous functions.",
      "core_topics": [
        "Set theory",
        "Formal logic",
        "Graph theory",
        "Combinatorics",
        "Proof by induction",
        "Recursion"
      ],
      "critical_dependency": "The logical baseline for computer science algorithm design and network routing analysis.",
      "prereqs": [
        "number-theory",
        "algebra-1"
      ],
      "acton_domains": [
        "Discrete Mathematics"
      ]
    }
  ],
